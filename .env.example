# Copy to .env and fill in values. Never commit .env.

# LLM backend: openai | anthropic | ollama | … (see graphify.llm)
CODEMIND_LLM_BACKEND=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:1234/v1

# Optional graphify tuning
# GRAPHIFY_OPENAI_MODEL=
# GRAPHIFY_MAX_OUTPUT_TOKENS=8192

# API (optional)
# CODEMIND_HOST=0.0.0.0
# CODEMIND_PORT=8000
# CODEMIND_DATA_DIR=./data

# Frontend (copy to frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
